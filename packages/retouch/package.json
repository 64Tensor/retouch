{
  "name": "@64tensor/retouch",
  "version": "0.3.0",
  "description": "Rétouch: a drop-in, canvas-based image and video editor for the browser. Crop, adjust, filters, curves, masks, trim, AI edits and your own tools.",
  "author": "64Tensor LLC (https://64tensor.com)",
  "license": "MIT",
  "homepage": "https://retouch.64tensor.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/64Tensor/retouch.git",
    "directory": "packages/retouch"
  },
  "bugs": {
    "url": "https://github.com/64Tensor/retouch/issues"
  },
  "keywords": [
    "canvas",
    "image-editor",
    "photo-editor",
    "video-editor",
    "retouch",
    "crop",
    "filters",
    "webcodecs",
    "typescript"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./package.json": "./package.json"
    },
    "types": "./dist/index.d.ts"
  },
  "files": [
    "dist",
    "docs",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json && tsc -p tests/tsconfig.json"
  },
  "dependencies": {
    "fabric": "^7.2.0",
    "gifenc": "^1.0.3",
    "mediabunny": "^1.46.0"
  }
}
